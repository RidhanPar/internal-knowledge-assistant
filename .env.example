# ─────────────────────────────────────────────────────────────────────────────
# Internal Knowledge Assistant — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres / pgvector ---------------------------------------------------
# The docker-compose stack publishes Postgres on host port 5434 (5432 and 5433
# are already taken on this machine). The app connects over this DSN.
DATABASE_URL=postgresql://ika:ika@localhost:5434/ika

# --- AWS Bedrock -----------------------------------------------------------
# Credentials are resolved by boto3's default chain: env vars, shared config
# (~/.aws/credentials), SSO, or an instance/role profile. Prefer a named
# profile or SSO over pasting keys here.
AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile

# Embedding model. Titan Text Embeddings v2 defaults to 1024 dims (also
# supports 512 / 256). The DB column dimension (see db/init/001_schema.sql)
# MUST match EMBEDDING_DIM — changing the model means a re-index.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# Generation model. This is a cross-region inference profile ID. Set it to the
# newest Claude you have enabled in the Bedrock console for your region.
# List what you can call:  aws bedrock list-inference-profiles --region us-east-1
# (or `aws bedrock list-foundation-models` for base model IDs).
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Retrieval / generation tuning ----------------------------------------
RETRIEVAL_TOP_K=6
# Minimum cosine similarity (0..1) a chunk must clear to be used as evidence.
# Below this, the assistant answers "I don't know" rather than guessing.
RETRIEVAL_MIN_SIMILARITY=0.30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- App -------------------------------------------------------------------
LOG_LEVEL=INFO
CORPUS_DIR=corpus
