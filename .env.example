# ─────────────────────────────────────────────────────────────────────────────
# Internal Knowledge Assistant environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres / pgvector ---------------------------------------------------
# The docker-compose stack publishes Postgres on host port 5434 (5432 and 5433
# are already taken on this machine). The app connects over this DSN.
DATABASE_URL=postgresql://ika:ika@localhost:5434/ika

# --- Anthropic API (generation) --------------------------------------------
# Get a key from the Anthropic Console. Never hardcode it in code.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if your key is organization-scoped, not workspace-scoped.
# ANTHROPIC_WORKSPACE_ID=wrkspc-...

# --- Embeddings (local sentence-transformers) ------------------------------
# bge-base-en-v1.5 emits 768 dims. EMBEDDING_DIM must match the vector(...)
# column in db/init/001_schema.sql. Changing the model means a re-index.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- Retrieval / generation tuning ----------------------------------------
RETRIEVAL_TOP_K=6
# Minimum cosine similarity (0..1) a chunk must clear to be used as evidence.
# Below this, the assistant answers "I don't know" rather than guessing.
RETRIEVAL_MIN_SIMILARITY=0.30
LLM_MAX_TOKENS=1024

# --- App -------------------------------------------------------------------
LOG_LEVEL=INFO
CORPUS_DIR=corpus
