# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# The SSH public key is the contents of your .pub file.

anthropic_api_key      = "sk-ant-..."
anthropic_workspace_id = "wrkspc_..."   # leave "" if your key is workspace-scoped
ssh_public_key         = "ssh-ed25519 AAAA... you@host"

# Optional overrides:
# region           = "eu-north-1"
# instance_type    = "t3.medium"
# allowed_ssh_cidr = "203.0.113.4/32"   # narrow SSH to your IP
